# Cynbit AutoBlueprint Environment Configuration
# Copy this file to .env and set GEMINI_API_KEY to enable Live Gemini LLM & Semantic Embedding mode.
# When GEMINI_API_KEY is omitted, the application runs in clearly labeled OFFLINE_DEMO_MODE.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AUTOBLUEPRINT_DB_PATH=data/autoblueprint.db
MAX_CRITIC_RETRIES=2
RAG_SIMILARITY_THRESHOLD=0.25
